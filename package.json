{
  "name": "florist-market",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --import tsx server/index.ts --dev",
    "build": "tsc --noEmit && vite build",
    "start": "node --import tsx server/index.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "backup": "node --import tsx server/backup.ts",
    "format": "prettier --write src server shared tests docs README.md vite.config.ts tsconfig.json package.json",
    "build:demo": "tsc --noEmit && vite build --mode demo",
    "preview:demo": "vite preview --mode demo --host 127.0.0.1",
    "test:wasm": "TEST_SQL_DRIVER=wasm node --import tsx --test tests/service.test.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.2.0",
    "@noble/hashes": "^2.4.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sql.js": "^1.16.0",
    "tsx": "^4.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^4.3.0",
    "fake-indexeddb": "^6.2.8",
    "prettier": "^3.10.1",
    "typescript": "^5.7.0",
    "vite": "^6.1.0"
  }
}
